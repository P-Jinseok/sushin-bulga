    {"id": "p5_007", "type": "choice", "timer": 0, "options": [{"text": "네, 맞는데요. 무슨 일이세요?", "tone": "calm", "next": "p5_r1_a", "effects": {"flags": {"met_nayeon": true}}}, {"text": "경찰이라는 증거 있어요?", "tone": "direct", "next": "p5_r1_b", "effects": {"affection": {"nayeon": 1}, "flags": {"met_nayeon": true}}}, {"text": "…보이스피싱인가요?", "tone": "joke", "next": "p5_r1_c", "effects": {"flags": {"met_nayeon": true}}}]},
    {"id": "p5_r1_a", "type": "msg", "speaker": "nayeon", "text": "용건은 간단해. 질문 몇 개만 할 거야.", "delay": 1910, "next": "p5_after1"},
