    {"id": "p5_021", "type": "msg", "speaker": "nayeon", "text": "번호는 추적이 안 되겠지. 그래도 보관해 둘게.", "delay": 2130, "next": "p5_m_end"},
    {"id": "p5_m_b", "type": "msg", "speaker": "nayeon", "text": "거짓말은 서툴군.", "delay": 1195},
    {"id": "p5_023", "type": "msg", "speaker": "nayeon", "text": "일단 넘어가 줄게.", "delay": 1250},
    {"id": "p5_024", "type": "msg", "speaker": "nayeon", "text": "다음엔 안 봐줘.", "delay": 1195, "next": "p5_m_end"},
