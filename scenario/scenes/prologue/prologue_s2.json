    {"id": "p2_035", "type": "choice", "timer": 0, "options": [{"text": "알겠어요. 기억해 둘게요.", "tone": "calm", "next": "p2_c_ok", "effects": {"flags": {"agreed_j": true}}}, {"text": "그런 일에 끼고 싶지 않아요.", "tone": "direct", "next": "p2_c_no"}, {"text": "(답하지 않는다)", "tone": "avoid", "send": false, "next": "p2_c_end"}]},
