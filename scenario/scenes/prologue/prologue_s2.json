    {"id": "p2_017", "type": "choice", "timer": 0, "options": [{"text": "경찰엔 신고했나요?", "tone": "direct", "next": "p2_a_police"}, {"text": "왜 저한테 이런 얘기를 하는 거예요?", "tone": "direct", "next": "p2_a_why"}, {"text": "…유감이에요.", "tone": "calm", "next": "p2_a_sorry"}]},
