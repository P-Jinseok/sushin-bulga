  "nodes": [
    {"id": "n2_001", "type": "fx", "kind": "time_jump", "time": "07:10", "day": "수요일"},
    {"id": "n2_002", "type": "fx", "kind": "notify", "text": "서 앞 편의점 벤치. 지금 와."},
    {"id": "n2_003", "type": "msg", "speaker": "nayeon", "text": "서 앞 편의점 벤치. 지금 와.", "delay": 1600},
    {"id": "n2_004", "type": "msg", "speaker": "nayeon", "text": "내가 나갈 때까지 서에는 들어오지 마.", "delay": 1900},
    {"id": "n2_005", "type": "msg", "speaker": "system", "text": "편의점 벤치에서 기다린다. 나연은 건물 안에 있다.", "delay": 2200},
    {"id": "n2_006", "type": "msg", "speaker": "nayeon", "text": "기다리게 했네.", "delay": 1300},
    {"id": "n2_007", "type": "msg", "speaker": "nayeon", "text": "먼저 하나만 확인한다.", "delay": 1500},
    {"id": "n2_008", "type": "msg", "speaker": "nayeon", "text": "어젯밤 이전 이틀 동안 어디서 뭘 했는지 말해.", "delay": 2200},
    {"id": "n2_009", "type": "choice", "timer": 0, "options": [{"text": "이삿짐 업체와 관리인 확인을 받으실 수 있어요.", "tone": "calm", "send": "이사 업체 기록이랑 관리인한테서 확인받으실 수 있어요.", "next": "n2_d_cooperate", "effects": {"affection": {"nayeon": 2}, "flags": {"cooperated_nayeon": true}}}, {"text": "제가 용의자라도 되는 거예요?", "tone": "direct", "next": "n2_d_resist", "effects": {"affection": {"nayeon": -1}}}, {"text": "(기록을 모두 보내 준다)", "tone": "calm", "send": "통화 기록이랑 이사 일정 캡처 보냈어요.", "next": "n2_d_all", "effects": {"affection": {"nayeon": 1}, "flags": {"cooperated_nayeon": true}}}]},
    {"id": "n2_d_cooperate", "type": "msg", "speaker": "nayeon", "text": "…확인하는 쪽이 빠르겠네.", "delay": 1700},
    {"id": "n2_011", "type": "msg", "speaker": "nayeon", "text": "업체 기록은 이미 봤어. 네 말이랑 같아.", "delay": 2000, "next": "n2_d_end"},
    {"id": "n2_d_resist", "type": "msg", "speaker": "nayeon", "text": "용의자였어. 어제까진.", "delay": 1500},
    {"id": "n2_013", "type": "msg", "speaker": "nayeon", "text": "그래서 확인하는 거야. 불쾌해도 참아.", "delay": 2000, "next": "n2_d_end"},
    {"id": "n2_d_all", "type": "msg", "speaker": "nayeon", "text": "…빠르네.", "delay": 1300},
    {"id": "n2_015", "type": "msg", "speaker": "nayeon", "text": "그래, 이 정도면 됐어.", "delay": 1600, "next": "n2_d_end"},
    {"id": "n2_d_end", "type": "msg", "speaker": "nayeon", "text": "판단은 끝났어. 넌 이 번호를 우연히 받은 거야.", "delay": 2400},
    {"id": "n2_017", "type": "msg", "speaker": "nayeon", "text": "오해하지 마. 믿는 게 아니라 확인이 끝난 거야.", "delay": 2300},
    {"id": "n2_018", "type": "msg", "speaker": "nayeon", "text": "이제 내 얘기를 한다.", "delay": 1500},
    {"id": "n2_019", "type": "msg", "speaker": "nayeon", "text": "작년 이 사건 담당이 나였어.", "delay": 1700},
    {"id": "n2_020", "type": "msg", "speaker": "nayeon", "text": "접수 3일 만에 종결 결재가 내려왔고.", "delay": 2000},
    {"id": "n2_021", "type": "msg", "speaker": "nayeon", "text": "사유는 자발적 잠적. 현장 확인도 안 끝났는데.", "delay": 2300},
    {"id": "n2_022", "type": "msg", "speaker": "nayeon", "text": "그래서 계속 보고 있었어. 비공식으로.", "delay": 2000},
    {"id": "n2_023", "type": "choice", "timer": 0, "options": [{"text": "그 결재, 누가 내렸어요?", "tone": "direct", "next": "n2_e_sign", "effects": {"flags": {"pressed_nayeon_sign": true}}}, {"text": "혼자 보고 있었던 거예요?", "tone": "calm", "next": "n2_e_alone", "effects": {"affection": {"nayeon": 1}}}, {"text": "그게 저한테 왜 필요한 얘기예요?", "tone": "avoid", "next": "n2_e_why"}]},
    {"id": "n2_e_sign", "type": "msg", "speaker": "nayeon", "text": "…그 얘긴 아직 못 한다.", "delay": 1700},
    {"id": "n2_025", "type": "msg", "speaker": "nayeon", "text": "말할 수 있는 건 위쪽이라는 거까지야.", "delay": 2000, "next": "n2_e_end"},
    {"id": "n2_e_alone", "type": "msg", "speaker": "nayeon", "text": "응. 혼자.", "delay": 1300},
    {"id": "n2_027", "type": "msg", "speaker": "nayeon", "text": "같이 볼 사람이 없었어.", "delay": 1700, "next": "n2_e_end"},
    {"id": "n2_e_why", "type": "msg", "speaker": "nayeon", "text": "네 번호가 거기 얽혔으니까.", "delay": 1600},
    {"id": "n2_029", "type": "msg", "speaker": "nayeon", "text": "모른 척하고 살 수도 없고.", "delay": 1700, "next": "n2_e_end"},
    {"id": "n2_e_end", "type": "msg", "speaker": "nayeon", "text": "이거 봐. 작년 기록이야.", "delay": 1500},
    {"id": "n2_031", "type": "msg", "speaker": "system", "text": "사진이 도착했다. 통화 기록 한 줄에 형광펜이 그어져 있다.", "delay": 2400},
    {"id": "n2_032", "type": "msg", "speaker": "nayeon", "text": "마지막 기지국 신호. 청하천 3번 다리, 작년 오늘 23시 07분.", "delay": 2600},
    {"id": "n2_033", "type": "msg", "speaker": "dohha", "text": "…23시 07분이요?", "delay": 720},
    {"id": "n2_034", "type": "msg", "speaker": "nayeon", "text": "맞아. 네가 첫 문자 받은 시각이랑 같지.", "delay": 2300},
    {"id": "n2_035", "type": "effect", "effects": {"clue": 1, "flags": {"clue_nayeon_2": true}}},
    {"id": "n2_036", "type": "cond", "if": {"any": [{"flag": "showed_nayeon_j"}, {"flag": "asked_nayeon_sign"}]}, "then": "n2_j_after", "else": "n2_j_unknown"},
    {"id": "n2_j_unknown", "type": "msg", "speaker": "dohha", "text": "아까 다리에서 말 못 한 게 있어요. 모르는 번호에서 문자가 왔어요.", "delay": 1260},
    {"id": "n2_038", "type": "msg", "speaker": "dohha", "text": "사건을 닫은 결재에 누구 서명이 있었는지 물어보라고요.", "delay": 1100},
    {"id": "n2_039", "type": "msg", "speaker": "nayeon", "text": "…왜 그 말을 지금 해.", "delay": 1700},
    {"id": "n2_040", "type": "msg", "speaker": "dohha", "text": "미안해요. 겁이 났어요.", "delay": 760},
    {"id": "n2_041", "type": "msg", "speaker": "nayeon", "text": "사과는 됐고. 그 번호, 지금 넘겨.", "delay": 1800, "next": "n2_j_end"},
    {"id": "n2_j_after", "type": "msg", "speaker": "nayeon", "text": "그 문자 보낸 놈, 같은 시각을 일부러 고른 거야.", "delay": 2300},
    {"id": "n2_043", "type": "msg", "speaker": "nayeon", "text": "이 사건을 아는 사람이야.", "delay": 1800},
    {"id": "n2_j_end", "type": "msg", "speaker": "nayeon", "text": "오늘 오후에 다시 연락할게. 휴대폰 꺼 두지 마.", "delay": 2200},
    {"id": "n2_045", "type": "msg", "speaker": "dohha", "text": "알겠어요.", "delay": 600},
    {"id": "n2_046", "type": "end_scene", "next": "nayeon_s21"}
  ]
}
