  "nodes": [
    {"id": "se2_001", "type": "fx", "kind": "time_jump", "time": "23:40", "day": "화요일"},
    {"id": "se2_002", "type": "msg", "speaker": "system", "text": "작업실. 모니터 세 대에서 푸른 선이 천천히 움직인다.", "delay": 2400},
    {"id": "se2_003", "type": "msg", "speaker": "sera", "text": "앉아. 거래 조건부터 정리한다.", "delay": 1800},
    {"id": "se2_004", "type": "msg", "speaker": "sera", "text": "하나. 네 번호로 들어오는 메시지 사본을 내게 준다.", "delay": 2300},
    {"id": "se2_005", "type": "msg", "speaker": "sera", "text": "둘. 나는 누가 네 번호를 보고 있는지 알려준다.", "delay": 2300},
    {"id": "se2_006", "type": "msg", "speaker": "sera", "text": "셋. 서로의 정보는 상대 허락 없이 제3자에게 안 준다.", "delay": 2500},
    {"id": "se2_007", "type": "choice", "timer": 0, "options": [{"text": "그 조건으로 해요.", "tone": "calm", "next": "se2_d_accept", "effects": {"affection": {"sera": 1}, "flags": {"deal_accepted": true}}}, {"text": "정보 먼저 받고 사본은 그다음에 줄게요.", "tone": "direct", "next": "se2_d_counter", "effects": {"affection": {"sera": 1}}}, {"text": "거래는 안 할래요. 저는 제 번호만 지키고 싶어요.", "tone": "avoid", "next": "se2_d_refuse", "effects": {"affection": {"sera": -1}}}]},
    {"id": "se2_d_accept", "type": "msg", "speaker": "sera", "text": "합의 성립.", "delay": 1300},
    {"id": "se2_009", "type": "msg", "speaker": "sera", "text": "깔끔해서 좋네.", "delay": 1300, "next": "se2_d_end"},
    {"id": "se2_d_counter", "type": "msg", "speaker": "sera", "text": "선결제 요구군.", "delay": 1500},
    {"id": "se2_011", "type": "msg", "speaker": "sera", "text": "합리적이야. 그럼 내가 먼저 하나 준다.", "delay": 2000, "next": "se2_d_end"},
    {"id": "se2_d_refuse", "type": "msg", "speaker": "sera", "text": "거절도 거래야.", "delay": 1500},
    {"id": "se2_013", "type": "msg", "speaker": "sera", "text": "그래도 정보는 준다. 네 번호가 위험하니까.", "delay": 2200, "next": "se2_d_end"},
    {"id": "se2_d_end", "type": "msg", "speaker": "sera", "text": "이거 봐.", "delay": 1200},
    {"id": "se2_015", "type": "msg", "speaker": "system", "text": "화면 캡처가 도착했다. 날짜별로 선이 이어져 있고 세 구간이 붉게 칠해져 있다.", "delay": 2800},
    {"id": "se2_016", "type": "msg", "speaker": "sera", "text": "3개월 전부터 이 회선을 정기적으로 조회한 기록이야.", "delay": 2400},
    {"id": "se2_017", "type": "msg", "speaker": "sera", "text": "회선이 해지된 뒤에도, 재할당된 뒤에도.", "delay": 2200},
    {"id": "se2_018", "type": "msg", "speaker": "sera", "text": "누가 이 번호를 계속 주시하고 있었다는 뜻이야.", "delay": 2300},
    {"id": "se2_019", "type": "choice", "timer": 0, "options": [{"text": "조회한 계정이 누구 건지 짐작되는 거 있어요?", "tone": "direct", "next": "se2_e_acct", "effects": {"clue": 1, "affection": {"sera": 1}, "flags": {"clue_sera_2": true}}}, {"text": "왜 이걸 저한테 알려 주는 거예요?", "tone": "calm", "next": "se2_e_why", "effects": {"affection": {"sera": 1}}}, {"text": "그냥 믿을게요.", "tone": "avoid", "next": "se2_e_trust"}]},
    {"id": "se2_e_acct", "type": "msg", "speaker": "sera", "text": "…짐작은 있어.", "delay": 1500},
    {"id": "se2_021", "type": "msg", "speaker": "sera", "text": "근거가 아직 없을 뿐.", "delay": 1600},
    {"id": "se2_022", "type": "msg", "speaker": "sera", "text": "그 계정은 관리 권한 계정이야. 일반 사용자는 못 써.", "delay": 2300, "next": "se2_e_end"},
    {"id": "se2_e_why", "type": "msg", "speaker": "sera", "text": "네 번호가 미끼가 됐으니까.", "delay": 1700},
    {"id": "se2_024", "type": "msg", "speaker": "sera", "text": "미끼는 정보를 가져야 오래 살아.", "delay": 1900, "next": "se2_e_end"},
    {"id": "se2_e_trust", "type": "msg", "speaker": "sera", "text": "비합리적이야.", "delay": 1300},
    {"id": "se2_026", "type": "msg", "speaker": "sera", "text": "믿음은 근거가 생긴 뒤에 하는 거야.", "delay": 2000, "next": "se2_e_end"},
    {"id": "se2_e_end", "type": "msg", "speaker": "sera", "text": "새벽에 확인할 게 있어. 다시 연락한다.", "delay": 2000},
    {"id": "se2_028", "type": "msg", "speaker": "sera", "text": "잠은 자 둬. 판단이 흐려져.", "delay": 1700},
    {"id": "se2_029", "type": "msg", "speaker": "dohha", "text": "알겠어요.", "delay": 600},
    {"id": "se2_030", "type": "end_scene", "next": "sera_s3"}
