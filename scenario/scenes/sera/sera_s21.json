  "start": "se21_001",
  "nodes": [
    {"id": "se21_001", "type": "fx", "kind": "time_jump", "time": "00:50", "day": "수요일"},
    {"id": "se21_002", "type": "msg", "speaker": "system", "text": "집에 돌아왔지만 잠은 오지 않았다.", "delay": 1800},
    {"id": "se21_003", "type": "msg", "speaker": "sera", "text": "자라고 했는데.", "delay": 1200},
    {"id": "se21_004", "type": "msg", "speaker": "sera", "text": "읽음이 떠 있어.", "delay": 1300},
    {"id": "se21_005", "type": "choice", "timer": 0, "options": [{"text": "잠이 안 와요.", "tone": "calm", "next": "se21_a_calm"}, {"text": "세라 씨는 안 자요?", "tone": "direct", "next": "se21_a_direct"}, {"text": "…", "tone": "avoid", "send": false, "next": "se21_a_avoid"}]},
    {"id": "se21_a_calm", "type": "msg", "speaker": "sera", "text": "예상한 변수야.", "delay": 1300, "next": "se21_a_end"},
    {"id": "se21_a_direct", "type": "msg", "speaker": "sera", "text": "나는 원래 이 시간이 효율적이야.", "delay": 1900, "next": "se21_a_end"},
    {"id": "se21_a_avoid", "type": "msg", "speaker": "sera", "text": "무응답도 데이터야.", "delay": 1500, "next": "se21_a_end"},
    {"id": "se21_a_end", "type": "msg", "speaker": "sera", "text": "사진 하나 보낸다. 분석하지 마.", "delay": 1900},
    {"id": "se21_010", "type": "msg", "speaker": "system", "text": "사진이 도착했다. 모니터 앞에 삼각김밥 세 개와 에너지 드링크 두 캔.", "delay": 2600},
    {"id": "se21_011", "type": "msg", "speaker": "sera", "text": "어제 저녁이야.", "delay": 1300},
    {"id": "se21_012", "type": "msg", "speaker": "sera", "text": "영양소 비율은 계산했어.", "delay": 1600},
    {"id": "se21_013", "type": "msg", "speaker": "sera", "text": "…완벽하진 않지만.", "delay": 1400},
    {"id": "se21_014", "type": "choice", "timer": 0, "options": [{"text": "삼각김밥 세 개로 계산이 돼요?", "tone": "joke", "next": "se21_b_joke"}, {"text": "제대로 드세요. 부탁이에요.", "tone": "calm", "next": "se21_b_calm", "effects": {"affection": {"sera": 1}}}, {"text": "저도 먹을게요. 같이요.", "tone": "direct", "next": "se21_b_with", "effects": {"affection": {"sera": 1}}}]},
    {"id": "se21_b_joke", "type": "msg", "speaker": "sera", "text": "탄수화물이 압도적이라는 결론이 나와.", "delay": 2200, "next": "se21_b_end"},
    {"id": "se21_b_calm", "type": "msg", "speaker": "sera", "text": "…알겠어.", "delay": 1200},
    {"id": "se21_017", "type": "msg", "speaker": "sera", "text": "컵라면 추가한다. 이게 타협안이야.", "delay": 2000, "next": "se21_b_end"},
    {"id": "se21_b_with", "type": "msg", "speaker": "sera", "text": "같이는 불가능해.", "delay": 1400},
    {"id": "se21_019", "type": "msg", "speaker": "sera", "text": "같은 시각에 먹는 건 가능하지.", "delay": 1800, "next": "se21_b_end"},
    {"id": "se21_b_end", "type": "msg", "speaker": "sera", "text": "컵라면 물은 450ml. 3분 20초.", "delay": 2000},
    {"id": "se21_021", "type": "msg", "speaker": "sera", "text": "시간 재는 건 습관이야.", "delay": 1600},
    {"id": "se21_022", "type": "msg", "speaker": "system", "text": "문자 사이로 타이머 알림음이 끼어들었다. 짧게, 세 번.", "delay": 2400},
    {"id": "se21_023", "type": "msg", "speaker": "sera", "text": "밤에는 네트워크가 조용해.", "delay": 1700},
    {"id": "se21_024", "type": "msg", "speaker": "sera", "text": "소리가 줄면 보이는 게 늘어.", "delay": 1800},
    {"id": "se21_025", "type": "msg", "speaker": "sera", "text": "그래서 이 시간에 일해.", "delay": 1500},
    {"id": "se21_026", "type": "choice", "timer": 0, "options": [{"text": "이 일은 어쩌다 하게 됐어요?", "tone": "calm", "next": "se21_c_why"}, {"text": "무서운 상대는 없어요?", "tone": "direct", "next": "se21_c_fear"}, {"text": "조금 쉬어요.", "tone": "avoid", "next": "se21_c_rest"}]},
    {"id": "se21_c_why", "type": "msg", "speaker": "sera", "text": "…재미있어서.", "delay": 1500},
    {"id": "se21_028", "type": "msg", "speaker": "sera", "text": "처음엔.", "delay": 1000},
    {"id": "se21_029", "type": "msg", "speaker": "sera", "text": "규칙이 있고 답이 있는 건 편했어.", "delay": 2000, "next": "se21_c_end"},
    {"id": "se21_c_fear", "type": "msg", "speaker": "sera", "text": "있어.", "delay": 1000},
    {"id": "se21_031", "type": "msg", "speaker": "sera", "text": "규칙을 아는 사람.", "delay": 1500},
    {"id": "se21_032", "type": "msg", "speaker": "sera", "text": "규칙을 알면 어길 방법도 아니까.", "delay": 2000, "next": "se21_c_end"},
    {"id": "se21_c_rest", "type": "msg", "speaker": "sera", "text": "쉬는 건 거래 종료 후에.", "delay": 1800},
    {"id": "se21_034", "type": "msg", "speaker": "sera", "text": "…고맙다는 말은 해 둘게.", "delay": 1700, "next": "se21_c_end"},
    {"id": "se21_c_end", "type": "msg", "speaker": "sera", "text": "너는 왜 이 번호를 안 바꿔?", "delay": 1800},
    {"id": "se21_036", "type": "choice", "timer": 0, "options": [{"text": "J가 바꾸지 말라고 했어요.", "tone": "calm", "next": "se21_d_j"}, {"text": "세라 씨도 그랬잖아요.", "tone": "direct", "next": "se21_d_you"}, {"text": "…잘 모르겠어요.", "tone": "avoid", "next": "se21_d_idk"}]},
    {"id": "se21_d_j", "type": "msg", "speaker": "sera", "text": "J 얘기는 나중에.", "delay": 1400, "next": "se21_d_end"},
    {"id": "se21_d_you", "type": "msg", "speaker": "sera", "text": "맞아. 바꾸면 추적이 끊겨.", "delay": 1900, "next": "se21_d_end"},
    {"id": "se21_d_idk", "type": "msg", "speaker": "sera", "text": "모르는 채로 두는 건 위험해.", "delay": 1900, "next": "se21_d_end"},
    {"id": "se21_d_end", "type": "msg", "speaker": "sera", "text": "그 번호 바꾸지 마. 이건 조건이야.", "delay": 2000},
    {"id": "se21_041", "type": "msg", "speaker": "sera", "text": "컵라면 불었다. 끊는다.", "delay": 1600},
    {"id": "se21_042", "type": "msg", "speaker": "sera", "text": "2시에 다시 연락한다.", "delay": 1500},
    {"id": "se21_043", "type": "end_scene", "next": "sera_s3"}
  ]
}
