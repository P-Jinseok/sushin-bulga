    {"id": "se1_017", "type": "choice", "timer": 0, "options": [{"text": "세라에게 J의 문자를 보여준다", "tone": "direct", "send": "방금 모르는 번호에서 문자가 왔어요. 당신의 거래는 늘 공정하다고, 그게 문제라고요.", "next": "se1_j_show", "effects": {"affection": {"sera": 1}, "flags": {"showed_sera_j": true}}}, {"text": "당신을 믿어도 되는지 묻는다", "tone": "direct", "send": "당신을 어디까지 믿어도 되는지 알고 싶어요.", "next": "se1_j_ask", "effects": {"flags": {"asked_sera_trust": true}}}, {"text": "아무 말도 하지 않는다", "tone": "avoid", "send": false, "next": "se1_j_hide", "effects": {"flags": {"hid_j_from_sera": true}}}]},
    {"id": "se1_j_show", "type": "msg", "speaker": "sera", "text": "공정하다는 평가는 틀리지 않아.", "delay": 1900},
    {"id": "se1_019", "type": "msg", "speaker": "sera", "text": "그 번호 정보 전부 넘겨.", "delay": 1500, "next": "se1_b_end"},
    {"id": "se1_j_ask", "type": "msg", "speaker": "sera", "text": "질문이 정확하네.", "delay": 1500},
