    {"id": "se1_001", "type": "msg", "speaker": "sera", "text": "B 출구 앞. 22시 55분 정각이야.", "delay": 1500},
    {"id": "se1_002", "type": "msg", "speaker": "sera", "text": "위치 공유 껐어?", "delay": 1200},
