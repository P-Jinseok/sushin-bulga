    {"id": "se1_028", "type": "choice", "timer": 0, "options": [{"text": "그 장비가 어디 있는지 찾아봐요.", "tone": "direct", "next": "se1_c_find", "effects": {"alert": 1}}, {"text": "신호 기록을 사본으로 받아 둬요.", "tone": "calm", "next": "se1_c_log", "effects": {"affection": {"sera": 1}, "flags": {"sera_log": true}}}, {"text": "일단 자리를 옮겨요.", "tone": "avoid", "next": "se1_c_move"}]},
