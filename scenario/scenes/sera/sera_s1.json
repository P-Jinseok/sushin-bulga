    {"id": "se1_023", "type": "msg", "speaker": "sera", "text": "숨기는 게 있으면 거래는 성립 안 해.", "delay": 2000, "next": "se1_b_end"},
    {"id": "se1_b_end", "type": "msg", "speaker": "system", "text": "밤 11시.", "delay": 1600},
