  "nodes": [
    {"id": "h3_001", "type": "fx", "kind": "time_jump", "time": "07:40", "day": "수요일"},
    {"id": "h3_002", "type": "fx", "kind": "notify", "text": "도하 씨, 잠은 좀 주무셨어요?"},
    {"id": "h3_003", "type": "msg", "speaker": "harin", "text": "도하 씨, 잠은 좀 주무셨어요?", "delay": 2200},
    {"id": "h3_004", "type": "msg", "speaker": "harin", "text": "저는 한숨도 못 잤어요. 그런데 이상하게 가벼워요.", "delay": 2800},
    {"id": "h3_005", "type": "msg", "speaker": "harin", "text": "밤새 기억나는 걸 적어 봤어요. 유진이가 마지막에 한 말들요.", "delay": 3000},
    {"id": "h3_006", "type": "msg", "speaker": "harin", "text": "그러다 이게 나왔어요.", "delay": 2000},
    {"id": "h3_007", "type": "msg", "speaker": "harin", "text": "그날 식당에서 유진이가 건넨 영수증이에요.", "delay": 2600},
    {"id": "h3_008", "type": "msg", "speaker": "harin", "text": "주머니에 그냥 넣어 뒀었는데, 뒷면에 글씨가 있어요.", "delay": 2800},
    {"id": "h3_009", "type": "msg", "speaker": "system", "text": "영수증 뒷면 사진이 도착했다. 연필로 눌러쓴 글씨가 번졌다.", "delay": 2400},
    {"id": "h3_010", "type": "msg", "speaker": "harin", "text": "'B-17'이라고 적혀 있어요.", "delay": 2200},
    {"id": "h3_011", "type": "msg", "speaker": "harin", "text": "무슨 뜻인지는 모르겠어요.", "delay": 2200},
    {"id": "h3_012", "type": "effect", "effects": {"clue": 1, "flags": {"harin_receipt": true}}},
    {"id": "h3_013", "type": "msg", "speaker": "harin", "text": "저는 어떻게 하면 좋을까요?", "delay": 2400},
    {"id": "h3_014", "type": "msg", "speaker": "harin", "text": "경찰에 가서 전부 말해야 할 것 같아요.", "delay": 2600},
    {"id": "h3_015", "type": "msg", "speaker": "harin", "text": "무서워서 아직 손이 떨리지만요.", "delay": 2600},
    {"id": "h3_016", "type": "choice", "timer": 0, "options": [{"text": "같이 가요. 제가 옆에 있을게요.", "tone": "calm", "next": "h3_g_together", "effects": {"affection": {"harin": 1}, "flags": {"decision_together": true}}}, {"text": "오늘은 쉬어요. 정할 수 있을 때 정해요.", "tone": "calm", "next": "h3_g_wait", "effects": {"affection": {"harin": 1}, "flags": {"decision_wait": true}}}, {"text": "더 숨기면 유진 씨한테도 도움이 안 돼요.", "tone": "direct", "next": "h3_g_push", "effects": {"affection": {"harin": -1}, "flags": {"pushed_harin": true}}}]},
    {"id": "h3_g_together", "type": "msg", "speaker": "harin", "text": "…네. 그 말을 기다렸는지도 몰라요.", "delay": 2800},
    {"id": "h3_018", "type": "msg", "speaker": "harin", "text": "작년 담당이 강나연 형사님이셨어요.", "delay": 2600},
    {"id": "h3_019", "type": "msg", "speaker": "harin", "text": "그분께 거짓말을 한 거네요, 저는.", "delay": 2600},
    {"id": "h3_020", "type": "msg", "speaker": "harin", "text": "그래도 도하 씨가 옆에 있으면 갈 수 있을 것 같아요.", "delay": 3000, "next": "h3_g_end"},
    {"id": "h3_g_wait", "type": "msg", "speaker": "harin", "text": "…네. 그래도 될까요.", "delay": 2200},
    {"id": "h3_022", "type": "msg", "speaker": "harin", "text": "오늘 하루만 더 생각해 볼게요.", "delay": 2400, "next": "h3_g_end"},
    {"id": "h3_g_push", "type": "msg", "speaker": "harin", "text": "…", "delay": 2600},
    {"id": "h3_024", "type": "msg", "speaker": "harin", "text": "맞는 말이에요.", "delay": 2200},
    {"id": "h3_025", "type": "msg", "speaker": "harin", "text": "그런데 지금은 그 말이 너무 아파요.", "delay": 3000},
    {"id": "h3_026", "type": "msg", "speaker": "harin", "text": "죄송해요. 오늘은 여기까지 할게요.", "delay": 2600, "next": "h3_g_end"},
    {"id": "h3_g_end", "type": "end_scene", "next": "harin_s31"}
  ]
}
