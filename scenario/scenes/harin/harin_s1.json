{
  "sceneId": "harin_s1",
  "title": "다리 입구",
  "route": "harin",
  "room": "harin",
  "time": "22:52",
  "day": "화요일",
  "start": "h1_001",
  "nodes": [
    {"id": "h1_001", "type": "msg", "speaker": "harin", "text": "저 거의 다 왔어요. 지금 어디쯤이세요?", "delay": 2000},
    {"id": "h1_002", "type": "choice", "timer": 0, "options": [{"text": "다리 입구 가로등 아래예요.", "tone": "calm", "next": "h1_a_wait"}, {"text": "벌써 다리 위까지 올라와 있어요.", "tone": "direct", "next": "h1_a_up", "effects": {"alert": 1, "flags": {"went_up_early": true}}}]},
    {"id": "h1_a_wait", "type": "msg", "speaker": "harin", "text": "다행이에요. 거기서 움직이지 마세요.", "delay": 1800, "next": "h1_a_end"},
    {"id": "h1_a_up", "type": "msg", "speaker": "harin", "text": "…네? 안 돼요, 지금 바로 내려오세요.", "delay": 2200},
    {"id": "h1_005", "type": "msg", "speaker": "harin", "text": "부탁이에요. 혼자 더 들어가면 안 돼요.", "delay": 2400},
    {"id": "h1_006", "type": "msg", "speaker": "dohha", "text": "알겠어요, 내려갈게요.", "delay": 740},
    {"id": "h1_007", "type": "msg", "speaker": "harin", "text": "…고마워요.", "delay": 1030, "next": "h1_a_end"},
    {"id": "h1_a_end", "type": "fx", "kind": "typing", "duration": 2500},
    {"id": "h1_009", "type": "msg", "speaker": "harin", "text": "도착했어요. 오른쪽 가로등 옆이에요.", "delay": 2000},
    {"id": "h1_010", "type": "msg", "speaker": "harin", "text": "그런데 여기서는 말소리가 이상하게 울려요.", "delay": 2600},
    {"id": "h1_011", "type": "msg", "speaker": "harin", "text": "그냥 문자로만 이야기해도 될까요?", "delay": 2200},
    {"id": "h1_012", "type": "msg", "speaker": "dohha", "text": "네, 그게 편해요.", "delay": 700},
    {"id": "h1_013", "type": "msg", "speaker": "system", "text": "나란히 서서 문자를 주고받는다. 가로등이 한 번 깜빡였다.", "delay": 2400},
    {"id": "h1_014", "type": "msg", "speaker": "system", "text": "밤 10시 58분.", "delay": 1600},
    {"id": "h1_015", "type": "fx", "kind": "notify", "room": "j", "text": "…서하린 씨와 계시군요."},
    {"id": "h1_016", "type": "msg", "speaker": "j", "text": "…서하린 씨와 계시군요.", "delay": 2200, "room": "j"},
    {"id": "h1_017", "type": "msg", "speaker": "j", "text": "그분께 물어보세요.", "delay": 2000, "room": "j"},
    {"id": "h1_018", "type": "msg", "speaker": "j", "text": "작년 오늘 이 시각에 어디 계셨는지.", "delay": 2600, "room": "j"},
    {"id": "h1_019", "type": "msg", "speaker": "system", "text": "다른 방에서 메시지가 왔다. 하린은 아직 모른다.", "delay": 2200},
    {"id": "h1_020", "type": "choice", "timer": 0, "options": [{"text": "하린에게 J의 문자를 보여준다", "tone": "direct", "send": "방금 모르는 번호에서 문자가 왔어요. 작년 오늘 이 시각에 어디 있었는지 물어보라고요.", "next": "h1_j_show", "effects": {"flags": {"showed_harin_j": true}}}, {"text": "아무 말도 하지 않는다", "tone": "avoid", "send": false, "next": "h1_j_hide", "effects": {"flags": {"hid_j_from_harin": true}}}, {"text": "괜찮아요? 얼굴이 많이 굳어 보여요.", "tone": "calm", "next": "h1_j_care", "effects": {"affection": {"harin": 1}}}]},
    {"id": "h1_j_show", "type": "msg", "speaker": "harin", "text": "…작년 오늘, 이 시각에요?", "delay": 2400},
    {"id": "h1_022", "type": "msg", "speaker": "harin", "text": "죄송해요. 잠깐만 숨 좀 고를게요.", "delay": 2400, "next": "h1_b_end"},
    {"id": "h1_j_hide", "type": "msg", "speaker": "harin", "text": "…도하 씨, 무슨 일 있어요?", "delay": 2200},
    {"id": "h1_024", "type": "msg", "speaker": "harin", "text": "하실 말씀이 있으면 천천히 하세요.", "delay": 2200, "next": "h1_b_end"},
    {"id": "h1_j_care", "type": "msg", "speaker": "harin", "text": "…표정이 그렇게 보였어요?", "delay": 2200},
    {"id": "h1_026", "type": "msg", "speaker": "harin", "text": "괜찮아요. 아니, 괜찮은 척하고 있어요.", "delay": 2600, "next": "h1_b_end"},
    {"id": "h1_b_end", "type": "msg", "speaker": "system", "text": "밤 11시.", "delay": 1800},
    {"id": "h1_028", "type": "msg", "speaker": "system", "text": "다리 한가운데에서 작은 불빛이 켜졌다 꺼졌다.", "delay": 2600},
    {"id": "h1_029", "type": "msg", "speaker": "harin", "text": "…저쪽에 누가 있었어요?", "delay": 2200},
    {"id": "h1_030", "type": "choice", "timer": 0, "options": [{"text": "가 볼까요?", "tone": "direct", "next": "h1_c_go", "effects": {"alert": 1}}, {"text": "여기서 기다려요. 더 가면 위험해요.", "tone": "calm", "next": "h1_c_stay", "effects": {"affection": {"harin": 1}}}, {"text": "…돌아갈까요?", "tone": "avoid", "next": "h1_c_back"}]},
    {"id": "h1_c_go", "type": "msg", "speaker": "harin", "text": "가지 마세요. 제발요.", "delay": 2000},
    {"id": "h1_032", "type": "msg", "speaker": "harin", "text": "저 혼자 두고 가시면 안 돼요.", "delay": 2400, "next": "h1_c_end"},
    {"id": "h1_c_stay", "type": "msg", "speaker": "harin", "text": "…네. 옆에 있을게요.", "delay": 2000, "next": "h1_c_end"},
    {"id": "h1_c_back", "type": "msg", "speaker": "harin", "text": "아니에요. 오늘은 끝까지 있고 싶어요.", "delay": 2400},
    {"id": "h1_035", "type": "msg", "speaker": "harin", "text": "조금만 더요. 확인하고 싶어요.", "delay": 2200, "next": "h1_c_end"},
    {"id": "h1_c_end", "type": "msg", "speaker": "system", "text": "불빛은 다시 나타나지 않았다. 11시 4분.", "delay": 2400},
    {"id": "h1_037", "type": "msg", "speaker": "harin", "text": "…아무도 없네요.", "delay": 2000},
    {"id": "h1_038", "type": "msg", "speaker": "harin", "text": "죄송해요. 사실 여기 오기 싫었어요.", "delay": 2600},
    {"id": "h1_039", "type": "msg", "speaker": "harin", "text": "도하 씨가 가자고 해서 용기를 냈어요.", "delay": 2600},
    {"id": "h1_040", "type": "msg", "speaker": "harin", "text": "저, 유진이를 마지막으로 만난 사람이에요.", "delay": 3200},
    {"id": "h1_041", "type": "msg", "speaker": "harin", "text": "여기서는 말하기가 어려워요. 저희 카페로 가요.", "delay": 2800},
    {"id": "h1_042", "type": "msg", "speaker": "harin", "text": "걸어서 5분이에요.", "delay": 1800},
    {"id": "h1_043", "type": "msg", "speaker": "dohha", "text": "알겠어요. 같이 가요.", "delay": 740},
    {"id": "h1_044", "type": "end_scene", "next": "harin_s2"}
  ]
}
