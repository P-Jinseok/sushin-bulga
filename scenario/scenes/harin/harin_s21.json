  "nodes": [
    {"id": "h21_001", "type": "fx", "kind": "time_jump", "time": "00:50", "day": "수요일"},
    {"id": "h21_002", "type": "msg", "speaker": "dohha", "text": "집에 도착했어요. 하린 씨는요?", "delay": 1200},
    {"id": "h21_003", "type": "msg", "speaker": "harin", "text": "저는 아직 카페예요.", "delay": 1500},
    {"id": "h21_004", "type": "msg", "speaker": "harin", "text": "마감 청소가 남아서요. 아니, 솔직히는 집에 가기 싫어서요.", "delay": 2600},
    {"id": "h21_005", "type": "msg", "speaker": "harin", "text": "불 꺼진 집이 너무 조용하거든요.", "delay": 1900},
    {"id": "h21_006", "type": "choice", "timer": 0, "options": [{"text": "그럼 문자로 같이 있어요.", "tone": "calm", "next": "h21_a_with", "effects": {"affection": {"harin": 1}}}, {"text": "무리하지 말고 들어가요.", "tone": "avoid", "next": "h21_a_go"}, {"text": "마감은 어떻게 하는지 궁금해요.", "tone": "joke", "next": "h21_a_ask"}]},
    {"id": "h21_a_with", "type": "msg", "speaker": "harin", "text": "…네. 그 말이 따뜻하네요.", "delay": 1800, "next": "h21_a_end"},
    {"id": "h21_a_go", "type": "msg", "speaker": "harin", "text": "그럴게요. 조금만 더 있다가요.", "delay": 1900, "next": "h21_a_end"},
    {"id": "h21_a_ask", "type": "msg", "speaker": "harin", "text": "어머, 재미없을 텐데요.", "delay": 1600},
    {"id": "h21_010", "type": "msg", "speaker": "harin", "text": "그래도 말씀드릴게요.", "delay": 1400, "next": "h21_a_end"},
    {"id": "h21_a_end", "type": "msg", "speaker": "harin", "text": "마감할 때 컵을 전부 뒤집어서 말려요.", "delay": 2200},
    {"id": "h21_012", "type": "msg", "speaker": "harin", "text": "마흔한 개요. 매일 세고, 하나라도 모자라면 불편해서요.", "delay": 2600},
    {"id": "h21_013", "type": "msg", "speaker": "harin", "text": "유진이 자주 쓰던 컵이 있어요. 손잡이가 살짝 깨진 거요.", "delay": 2600},
    {"id": "h21_014", "type": "msg", "speaker": "harin", "text": "버리지 못하고 맨 뒤 선반에 두었어요.", "delay": 2000},
    {"id": "h21_015", "type": "msg", "speaker": "harin", "text": "오늘은 그 컵을 닦았어요. 1년 만에 처음으로요.", "delay": 2400},
    {"id": "h21_016", "type": "choice", "timer": 0, "options": [{"text": "잘했어요. 오늘 큰일 한 거예요.", "tone": "calm", "next": "h21_b_good"}, {"text": "그 컵, 언젠가 보여 주세요.", "tone": "direct", "next": "h21_b_show"}, {"text": "(조용히 기다린다)", "tone": "avoid", "send": false, "next": "h21_b_wait"}]},
    {"id": "h21_b_good", "type": "msg", "speaker": "harin", "text": "…고마워요. 별일 아닌데 눈물이 나서요.", "delay": 2300, "next": "h21_b_end"},
    {"id": "h21_b_show", "type": "msg", "speaker": "harin", "text": "네. 언젠가요.", "delay": 1300},
    {"id": "h21_019", "type": "msg", "speaker": "harin", "text": "그날이 오면 좋겠어요.", "delay": 1600, "next": "h21_b_end"},
    {"id": "h21_b_wait", "type": "msg", "speaker": "harin", "text": "말없이 기다려 주셔서 고마워요.", "delay": 1900, "next": "h21_b_end"},
    {"id": "h21_b_end", "type": "msg", "speaker": "harin", "text": "저는 쉬는 법을 잘 몰라요.", "delay": 1700},
    {"id": "h21_022", "type": "msg", "speaker": "harin", "text": "가만히 있으면 생각이 따라와서요.", "delay": 1900},
    {"id": "h21_023", "type": "msg", "speaker": "harin", "text": "그래서 계속 뭔가를 닦고 있어요.", "delay": 1800},
    {"id": "h21_024", "type": "msg", "speaker": "harin", "text": "도하 씨는 어떻게 쉬세요?", "delay": 1500},
    {"id": "h21_025", "type": "choice", "timer": 0, "options": [{"text": "아무것도 안 하고 천장을 봐요.", "tone": "joke", "next": "h21_c_ceil"}, {"text": "누군가와 이야기해요. 지금처럼요.", "tone": "calm", "next": "h21_c_talk"}, {"text": "저도 잘 못 쉬어요.", "tone": "avoid", "next": "h21_c_same"}]},
    {"id": "h21_c_ceil", "type": "msg", "speaker": "harin", "text": "천장이요? 해 보고 싶네요.", "delay": 1800, "next": "h21_c_end"},
    {"id": "h21_c_talk", "type": "msg", "speaker": "harin", "text": "…지금처럼이요.", "delay": 1400},
    {"id": "h21_028", "type": "msg", "speaker": "harin", "text": "그럼 저도 쉬고 있는 거네요.", "delay": 1800, "next": "h21_c_end"},
    {"id": "h21_c_same", "type": "msg", "speaker": "harin", "text": "그럼 우리 둘 다 연습이 필요하겠네요.", "delay": 2200, "next": "h21_c_end"},
    {"id": "h21_c_end", "type": "msg", "speaker": "harin", "text": "이제 집에 갈게요.", "delay": 1400},
    {"id": "h21_031", "type": "msg", "speaker": "harin", "text": "가는 길에 불을 하나 더 켜 두려고요.", "delay": 2000},
    {"id": "h21_032", "type": "msg", "speaker": "harin", "text": "내일 아침에 이어서 이야기해요.", "delay": 1700},
    {"id": "h21_033", "type": "end_scene", "next": "harin_s3"}
  ]
}
