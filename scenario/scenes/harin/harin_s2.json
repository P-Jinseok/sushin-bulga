  "start": "h2_001",
  "nodes": [
    {"id": "h2_001", "type": "fx", "kind": "time_jump", "time": "23:40", "day": "화요일"},
    {"id": "h2_002", "type": "msg", "speaker": "system", "text": "문 닫은 카페 '온기'. 하린이 불을 하나만 켰다.", "delay": 2400},
    {"id": "h2_003", "type": "msg", "speaker": "harin", "text": "따뜻한 거 드릴게요. 앉으세요.", "delay": 2000},
    {"id": "h2_004", "type": "msg", "speaker": "harin", "text": "…여기서도 문자로 할게요.", "delay": 2200},
    {"id": "h2_005", "type": "msg", "speaker": "harin", "text": "소리 내서 말하면 사실이 되어 버릴 것 같아서요.", "delay": 2800},
    {"id": "h2_006", "type": "msg", "speaker": "harin", "text": "작년 오늘 저녁에 유진이랑 밥을 먹었어요.", "delay": 2600},
    {"id": "h2_007", "type": "msg", "speaker": "harin", "text": "10시 반쯤 전화가 왔어요. 받더니 표정이 굳었어요.", "delay": 2800},
    {"id": "h2_008", "type": "msg", "speaker": "harin", "text": "오늘 밤 11시에 만나야 할 사람이 있대요.", "delay": 2600},
    {"id": "h2_009", "type": "msg", "speaker": "harin", "text": "어디서 만나는지는 묻지 못했어요.", "delay": 2400},
    {"id": "h2_010", "type": "msg", "speaker": "harin", "text": "청하천 쪽이라는 것만 알았어요.", "delay": 2400},
    {"id": "h2_011", "type": "choice", "timer": 0, "options": [{"text": "왜 붙잡지 않았어요?", "tone": "direct", "next": "h2_d_push", "effects": {"affection": {"harin": -1}, "flags": {"pushed_harin": true}}}, {"text": "그 얘기를 꺼내기까지 오래 걸렸겠어요.", "tone": "calm", "next": "h2_d_soft", "effects": {"affection": {"harin": 2}}}, {"text": "(조용히 기다린다)", "tone": "avoid", "send": false, "next": "h2_d_wait", "effects": {"affection": {"harin": 1}}}]},
    {"id": "h2_d_push", "type": "msg", "speaker": "harin", "text": "…맞아요. 저도 매일 그 생각을 해요.", "delay": 2800},
    {"id": "h2_013", "type": "msg", "speaker": "harin", "text": "붙잡았어야 했는데.", "delay": 2200, "next": "h2_d_end"},
    {"id": "h2_d_soft", "type": "msg", "speaker": "harin", "text": "…네. 1년이 걸렸어요.", "delay": 2200},
    {"id": "h2_015", "type": "msg", "speaker": "harin", "text": "처음 말해 보는 거예요. 누구한테도.", "delay": 2600, "next": "h2_d_end"},
    {"id": "h2_d_wait", "type": "msg", "speaker": "harin", "text": "기다려 줘서 고마워요.", "delay": 2200},
    {"id": "h2_017", "type": "msg", "speaker": "harin", "text": "…천천히 말할게요.", "delay": 2000, "next": "h2_d_end"},
    {"id": "h2_d_end", "type": "msg", "speaker": "harin", "text": "유진이가 나가기 전에 부탁을 하나 했어요.", "delay": 2800},
    {"id": "h2_019", "type": "msg", "speaker": "harin", "text": "누가 물어도 오늘 자기를 못 봤다고 해 달라고요.", "delay": 3000},
    {"id": "h2_020", "type": "msg", "speaker": "harin", "text": "그 약속 때문에 경찰한테도 거짓말을 했어요.", "delay": 2800},
    {"id": "h2_021", "type": "msg", "speaker": "harin", "text": "그게 유진이를 지키는 일인 줄 알았어요.", "delay": 3000},
    {"id": "h2_022", "type": "choice", "timer": 0, "options": [{"text": "그때 유진 씨가 다른 말은 안 했어요? 열쇠 같은 거요.", "tone": "direct", "next": "h2_e_key", "effects": {"clue": 1, "affection": {"harin": 1}, "flags": {"clue_harin_2": true}}}, {"text": "그 약속은 하린 씨 잘못이 아니에요.", "tone": "calm", "next": "h2_e_comfort", "effects": {"affection": {"harin": 1}}}]},
    {"id": "h2_e_key", "type": "msg", "speaker": "harin", "text": "…열쇠요?", "delay": 2000},
    {"id": "h2_024", "type": "msg", "speaker": "harin", "text": "맞아요. 나가면서 그랬어요.", "delay": 2400},
    {"id": "h2_025", "type": "msg", "speaker": "harin", "text": "열쇠는 잘 뒀으니까 괜찮다고요.", "delay": 2600},
    {"id": "h2_026", "type": "msg", "speaker": "harin", "text": "무슨 열쇠인지는 저도 몰라요. 정말이에요.", "delay": 2800, "next": "h2_e_end"},
    {"id": "h2_e_comfort", "type": "msg", "speaker": "harin", "text": "…그렇게 말해 주는 사람은 처음이에요.", "delay": 2600},
    {"id": "h2_028", "type": "msg", "speaker": "harin", "text": "그래도 아직은 제 잘못이 아니라고 못 믿겠어요.", "delay": 2800, "next": "h2_e_end"},
    {"id": "h2_e_end", "type": "cond", "if": {"flag": "showed_harin_j"}, "then": "h2_j_known", "else": "h2_j_unknown"},
    {"id": "h2_j_unknown", "type": "msg", "speaker": "dohha", "text": "아까 말 안 한 게 있어요. 다리에서 모르는 번호로 문자가 왔어요.", "delay": 1240},
    {"id": "h2_031", "type": "msg", "speaker": "dohha", "text": "작년 오늘 이 시각에 어디 있었는지 물어보라고요.", "delay": 1040},
    {"id": "h2_032", "type": "msg", "speaker": "harin", "text": "…왜 아까는 말씀 안 하셨어요?", "delay": 2400},
    {"id": "h2_033", "type": "msg", "speaker": "dohha", "text": "겁이 났어요. 미안해요.", "delay": 760},
    {"id": "h2_034", "type": "msg", "speaker": "harin", "text": "아니에요. 저도 숨긴 사람인데요.", "delay": 2400, "next": "h2_j_join"},
    {"id": "h2_j_known", "type": "msg", "speaker": "harin", "text": "아까 보여 주신 문자요.", "delay": 2000},
    {"id": "h2_j_join", "type": "msg", "speaker": "harin", "text": "그 사람, 유진이 가족일지도 몰라요.", "delay": 2600},
    {"id": "h2_037", "type": "msg", "speaker": "harin", "text": "유진이한테는 동생이 하나 있어요.", "delay": 2400},
    {"id": "h2_038", "type": "msg", "speaker": "harin", "text": "사건 뒤에 한 번 전화가 왔는데 받지 못했어요.", "delay": 2800},
    {"id": "h2_039", "type": "msg", "speaker": "harin", "text": "받을 자격이 없는 것 같아서요.", "delay": 2600},
    {"id": "h2_040", "type": "effect", "effects": {"clue": 1, "flags": {"clue_harin_3": true}}},
    {"id": "h2_041", "type": "msg", "speaker": "harin", "text": "도하 씨, 저는 이제 어떻게 해야 할까요?", "delay": 2800},
    {"id": "h2_042", "type": "msg", "speaker": "harin", "text": "오늘은 너무 늦었어요. 내일 아침에 다시 이야기해요.", "delay": 2800},
    {"id": "h2_043", "type": "msg", "speaker": "harin", "text": "집에 도착하면 꼭 문자 주세요.", "delay": 2200},
    {"id": "h2_044", "type": "msg", "speaker": "dohha", "text": "알겠어요.", "delay": 600},
    {"id": "h2_045", "type": "end_scene", "next": "harin_s3"}
  ]
}
